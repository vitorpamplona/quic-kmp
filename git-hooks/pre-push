#!/bin/bash

GREEN='\033[0;32m'
NO_COLOR='\033[0m'

echo "*********************************************************"
echo "Running git pre-push hook."
echo "*********************************************************"
echo ""
echo "Java Version: "
echo "$JAVA_HOME"
echo "$(java -version)"
echo "Running test... "

# The same checks CI runs (.github/workflows/build.yml).
./gradlew spotlessCheck :quic:jvmTest :quic:testAndroidHostTest :quic-interop:test

status=$?

if [ "$status" = 0 ] ; then
    echo "All test passed."
    exit 0
else
    echo "*********************************************************"
    echo 1>&2 "Formatting or tests failed"
    printf "Run ${GREEN}./gradlew spotlessApply :quic:jvmTest :quic:testAndroidHostTest :quic-interop:test${NO_COLOR} and fix what fails before pushing...\n"
    echo "*********************************************************"
    exit 1
fi
